# Copy to .env.local (gitignored):  cp .env.example .env.local
#
# Phase 0 — pick your project in Supabase Dashboard, then copy the ref from the URL:
#   https://supabase.com/dashboard/project/<PROJECT_REF>
# Or run: npm run supabase:open-dashboard
# Paste the ref into supabase/.project-ref (one line), then: npm run supabase:configure
#
# API keys: Dashboard → Connect (top) or Project Settings → API

SUPABASE_PROJECT_REF=your-project-ref-here
VITE_SUPABASE_URL=https://your-project-ref-here.supabase.co
# Connect modal (React + Vite): copy publishable key. Legacy API page: use VITE_SUPABASE_ANON_KEY instead.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: allow "Send as guest" (display name only) without magic-link sign-in.
# Requires Anonymous sign-ins enabled in Supabase Auth. Also set Edge secret ALLOW_GUEST_SEND=true.
VITE_ALLOW_GUEST_SEND=true

# Test defaults (Resend onboarding@resend.dev can only deliver to your Resend signup email).
VITE_DEFAULT_RECIPIENT_EMAIL=kittucurious16047@gmail.com
VITE_DEFAULT_SENDER_NAME=kittucurious16047
