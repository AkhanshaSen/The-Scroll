{
  "name": "paper-scroll-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "supabase:open-dashboard": "open https://supabase.com/dashboard/projects",
    "supabase:configure": "node scripts/supabase-configure.mjs",
    "supabase:link": "npx supabase link --project-ref \"$(tr -d '[:space:]' < supabase/.project-ref)\"",
    "supabase:deploy-send": "npx supabase functions deploy send-scroll --project-ref \"$(node -e \"const fs=require('fs');const m=fs.readFileSync('.env.local','utf8').match(/^SUPABASE_PROJECT_REF=(.+)$/m);if(!m)process.exit(1);process.stdout.write(m[1].trim())\")\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
